{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V6 Content Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "graphId", "title", "sourceRef", "extraction", "sourceDecisions", "nodes", "edges"],
  "allOf": [
    {
      "if": { "properties": { "version": { "const": "6.0-alpha.5" } } },
      "then": { "properties": { "extraction": { "required": ["protocol", "sourceSha256", "sourceUnitCount", "draftSha256", "sealedAt"] } } }
    }
  ],
  "properties": {
    "version": { "enum": ["6.0-alpha.2", "6.0-alpha.3", "6.0-alpha.4", "6.0-alpha.5"] },
    "graphId": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 2 },
    "subtitle": { "type": "string" },
    "sourceRef": { "type": "string", "minLength": 3 },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "sourceSha256", "sourceUnitCount", "sealedAt"],
      "properties": {
        "protocol": { "const": "evidence-ledger-v1" },
        "sourceSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "sourceUnitCount": { "type": "integer", "minimum": 1 },
        "draftSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "sealedAt": { "type": "string" }
      }
    },
    "sourceDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "decision", "nodeIds", "reason"],
        "properties": {
          "unitId": { "type": "string" },
          "decision": { "enum": ["preserve", "merge", "drop"] },
          "nodeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "reason": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "headline", "importance", "sourceQuote", "sourceUnitIds"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["thesis", "context", "metric", "trend", "result", "capability", "stage", "action", "risk", "constraint", "evidence", "option", "criterion", "actor", "input", "output", "unresolved"] },
          "headline": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "importance": { "enum": ["critical", "high", "medium", "low"] },
          "sourceQuote": { "type": "string", "minLength": 1 },
          "sourceUnitIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "group": { "type": "string" },
          "actor": { "type": "string" },
          "order": { "type": "number" },
          "status": { "enum": ["neutral", "good", "warning", "risk", "pending"] },
          "recommended": { "type": "boolean" },
          "riskLevel": { "enum": ["high", "medium", "low"] },
          "control": { "type": "string", "minLength": 1 },
          "measure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["display"],
            "properties": {
              "display": { "type": "string", "minLength": 1 },
              "value": { "type": ["number", "string"] },
              "unit": { "type": "string" },
              "direction": { "enum": ["up", "down", "flat", "target", "range"] }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "from", "to"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["supports", "causes", "precedes", "produces", "depends-on", "belongs-to", "contrasts", "owned-by", "measures"] },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    }
  }
}
